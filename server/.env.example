# optikí API — environment template.
#
# Copy to `.env` and fill in. Only loaded when GO_ENV=development, which
# `make run` sets for you — do not set GO_ENV here.
#
# ── Required to boot ──────────────────────────────────────────────────────────

# Postgres DSN used by local development. The database must already exist;
# tables are created by GORM AutoMigrate on first boot.
OPTIKI_DEV_DSN_LOCAL=postgres://optiki:optiki@localhost:5432/optiki?sslmode=disable

# Signs the access and refresh JWTs. At least 32 characters: `openssl rand -hex 32`.
JWT_SECRET=

# ── Deployed environments only — set in ~/optiki.env on the server, leave blank locally ──

# Selected whenever GO_ENV=production.
OPTIKI_PROD_DSN=
# Public origin of the client (https://optikii.netlify.app), used in email links and CORS.
APP_BASE_URL=
# Commit served by this deployment, reported by /health. Baked into the image when deployed.
GIT_SHA=

# ── Optional: transactional email (Resend) ────────────────────────────────────
# Without a key, local development logs each email (with its link or code)
# instead of sending it. Resend's test sender only delivers to your own address.
RESEND_API_KEY=
RESEND_SENDER_EMAIL=

# ── Optional: scan screenshots (S3) ──────────────────────────────────────────
# Rendered scans upload a JPEG screenshot to a private bucket and return it with
# a 30-minute presigned URL. Without all four values, scans still work and are
# stored without screenshots. S3_ENDPOINT and S3_USE_PATH_STYLE=true point it at
# an S3-compatible store (MinIO, R2, Spaces) instead of AWS.
S3_ACCESS_KEY_ID=
S3_ACCESS_KEY=
S3_BUCKET_NAME=
AWS_REGION=
S3_ENDPOINT=
S3_USE_PATH_STYLE=false

# ── Optional: Chromium for rendered scans ─────────────────────────────────────
# Set in the Docker image. Locally, leave empty to use Chrome/Chromium on PATH.
CHROME_BIN=

# ── Optional: verified demo accounts for TestSprite ───────────────────────────
# Created once on boot when SEED_DEMO=true. Never commit real values.
SEED_DEMO=false
DEMO_NAME=
DEMO_EMAIL=
DEMO_PASSWORD=
DEMO_NAME_2=
DEMO_EMAIL_2=
DEMO_PASSWORD_2=
