# optikí API — environment template.
#
# Copy to `.env` and fill in. Only loaded when GO_ENV=development, which
# `make run` sets for you — do not set GO_ENV here.
#
# ── Required to boot ──────────────────────────────────────────────────────────

# Postgres DSN used by local development. The database must already exist;
# tables are created by GORM AutoMigrate on first boot.
OPTIKI_DEV_DSN_LOCAL=postgres://optiki:optiki@localhost:5432/optiki?sslmode=disable

# Signs the access and refresh JWTs. At least 32 characters: `openssl rand -hex 32`.
JWT_SECRET=

# ── Deployed environments only — set in ~/optiki.env on the server, leave blank locally ──

# Selected whenever GO_ENV=production.
OPTIKI_PROD_DSN=
# Commit served by this deployment, reported by /health. Baked into the image when deployed.
GIT_SHA=

# ── Optional: transactional email (Resend) ────────────────────────────────────
# Without a key, local development logs each email (with its link or code)
# instead of sending it. Resend's test sender only delivers to your own address.
RESEND_API_KEY=
RESEND_SENDER_EMAIL=

# ── Scan screenshots (S3): the same bucket in both environments ──────────────
# Rendered scans upload a JPEG screenshot to the private bucket and return it
# with a 30-minute presigned URL. Local development uses the real bucket, just
# like the server: copy the production values here. Without all four, scans
# still work and are stored without screenshots.
# S3_ENDPOINT and S3_USE_PATH_STYLE=true are only for S3-compatible stores (R2, Spaces).
S3_ACCESS_KEY_ID=
S3_ACCESS_KEY=
S3_BUCKET_NAME=
AWS_REGION=
S3_ENDPOINT=
S3_USE_PATH_STYLE=false

# ── Chromium for rendered scans ───────────────────────────────────────────────
# Set in the Docker image. Locally, leave empty to use Chrome/Chromium on PATH;
# the server warns at boot when it finds neither.
CHROME_BIN=

# ── Verified demo accounts ────────────────────────────────────────────────────
# Created once on boot when SEED_DEMO=true. These defaults are for local
# development only and are public: ~/optiki.env on the server sets its own.
SEED_DEMO=true
DEMO_NAME=Demo User
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=optiki-demo-1
DEMO_NAME_2=Demo User Two
DEMO_EMAIL_2=demo2@example.com
DEMO_PASSWORD_2=optiki-demo-2
