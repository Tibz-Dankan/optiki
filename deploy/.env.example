# Copy to ~/optiki/deploy/.env on the VPS (read by `docker compose up`). Never commit the copy.

# Let's Encrypt account email (expiry notices)
ACME_EMAIL=

# Password of the shared `optiki` database: `openssl rand -hex 24`.
# Use the same value in the DSNs of ~/optiki/preview.env and ~/optiki/prod.env.
POSTGRES_PASSWORD=
