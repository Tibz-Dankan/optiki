# Copy to ~/optiki/preview.env on the VPS. Every PR preview reads it; the deploy
# script adds OPTIKI_ENV=pr-<n>, APP_BASE_URL and GIT_SHA per container.
# Docker env-file format: KEY=value, no quotes, no `export`.

# The one shared database (host = the Postgres container on the optiki-db network)
OPTIKI_PROD_DSN=postgres://optiki:<POSTGRES_PASSWORD>@optiki-postgres:5432/optiki?sslmode=disable

# At least 32 characters: `openssl rand -hex 32`. Use a different value from prod.env.
JWT_SECRET=

# Resend (a verified sending domain is needed to email anyone but yourself)
RESEND_API_KEY=
RESEND_SENDER_EMAIL=

# Verified accounts TestSprite signs in with; created in each preview's env on boot.
# Store the same values in the TestSprite portal, nowhere else.
SEED_DEMO=true
DEMO_NAME=
DEMO_EMAIL=
DEMO_PASSWORD=
DEMO_NAME_2=
DEMO_EMAIL_2=
DEMO_PASSWORD_2=
