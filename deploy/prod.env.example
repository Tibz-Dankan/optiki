# Copy to ~/optiki/prod.env on the VPS. Read by the production container; the
# deploy script adds OPTIKI_ENV=production, APP_BASE_URL and GIT_SHA.
# Docker env-file format: KEY=value, no quotes, no `export`.

# Same database as the previews; production rows are tagged env=production
OPTIKI_PROD_DSN=postgres://optiki:<POSTGRES_PASSWORD>@optiki-postgres:5432/optiki?sslmode=disable

# At least 32 characters: `openssl rand -hex 32`. Different from preview.env.
JWT_SECRET=

RESEND_API_KEY=
RESEND_SENDER_EMAIL=

# Demo accounts for judges and the TestSprite portal's production project
SEED_DEMO=true
DEMO_NAME=
DEMO_EMAIL=
DEMO_PASSWORD=
DEMO_NAME_2=
DEMO_EMAIL_2=
DEMO_PASSWORD_2=
